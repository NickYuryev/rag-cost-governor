# Pick one. Mock is used when neither is set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which backend to use: mock, openai, anthropic
RCG_LLM_BACKEND=mock
RCG_LLM_MODEL=gpt-4o-mini

# USD ceiling per query. The graph short-circuits when a reserve would exceed it.
RCG_BUDGET_USD=0.05

# Qdrant. Use :memory: to run everything in-process (good for CI and demos).
RCG_QDRANT_URL=:memory:
RCG_QDRANT_COLLECTION=filings

# Prometheus /metrics port. Set to 0 to disable the exporter.
RCG_METRICS_PORT=9090

# EDGAR requires a contact string in the User-Agent header.
RCG_EDGAR_USER_AGENT=rag-cost-governor contact@example.com
